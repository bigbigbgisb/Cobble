<?xml version="1.0"?>
<SyntaxDefinition name="C# (Modern VS Dark+)" extensions=".cs" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
    <!-- === VS Dark+ 配色表 === -->
    <Color name="Comment" foreground="#6A9955" />
    <Color name="String" foreground="#CE9178" />
    <Color name="StringInterpolation" foreground="#569CD6" />
    <Color name="Char" foreground="#D7BA7D" />
    <Color name="Preprocessor" foreground="#C586C0" />
    <Color name="Punctuation" foreground="#D4D4D4" />
    
    <!-- 数据类型 -->
    <Color name="ValueTypeKeywords" foreground="#569CD6" />
    <Color name="ReferenceTypeKeywords" foreground="#4EC9B0" />
    <Color name="MethodCall" foreground="#DCDCAA" />
    <Color name="NumberLiteral" foreground="#B5CEA8" />
    <Color name="ThisOrBaseReference" foreground="#569CD6" />
    <Color name="NullOrValueKeywords" foreground="#569CD6" />
    
    <!-- 控制流与语法结构 -->
    <Color name="Keywords" foreground="#356DC1" />
    <Color name="GotoKeywords" foreground="#356DC1" />
    <Color name="ExceptionKeywords" foreground="#c586c0" />
    <Color name="CheckedKeyword" foreground="#356DC1" />
    <Color name="UnsafeKeywords" foreground="#356DC1" />
    <Color name="NamespaceKeywords" foreground="#356DC1" />
    <Color name="OperatorKeywords" foreground="#D4D4D4" />
    
    <!-- 修饰符与上下文关键字 -->
    <Color name="Modifiers" foreground="#569CD6" />
    <Color name="Visibility" foreground="#569CD6" />
    <Color name="ParameterModifiers" foreground="#569CD6" />
    <Color name="ContextKeywords" foreground="#569CD6" />
    
    <!-- 属性、布尔、内置函数 -->
    <Color name="GetSetAddRemove" foreground="#569CD6" />
    <Color name="TrueFalse" foreground="#569CD6" />
    <Color name="TypeKeywords" foreground="#569CD6" />
    <Color name="SemanticKeywords" foreground="#569CD6" />
    <Property name="DocCommentMarker" value="///" />
    
    <RuleSet name="CommentMarkerSet">
        <Keywords fontWeight="bold" foreground="#FF5370">
            <Word>TODO</Word>
            <Word>FIXME</Word>
            <Word>HACK</Word>
            <Word>UNDONE</Word>
        </Keywords>
    </RuleSet>
    
    <RuleSet>
        <!-- 预处理指令 -->
        <Span color="Preprocessor">
            <Begin>\#</Begin>
            <RuleSet name="PreprocessorSet">
                <Span>
                    <Begin fontWeight="bold">(define|undef|if|elif|else|endif|line|region|endregion|error|warning|pragma|nullable)\b</Begin>
                    <RuleSet>
                        <Span color="Comment" ruleSet="CommentMarkerSet">
                            <Begin>//</Begin>
                        </Span>
                    </RuleSet>
                </Span>
            </RuleSet>
        </Span>
        
        <!-- 文档注释与普通注释 -->
        <Span color="Comment">
            <Begin color="XmlDoc/DocComment">///(?!/)</Begin>
            <RuleSet>
                <Import ruleSet="XmlDoc/DocCommentSet"/>
                <Import ruleSet="CommentMarkerSet"/>
            </RuleSet>
        </Span>
        
        <Span color="Comment" ruleSet="CommentMarkerSet">
            <Begin>//</Begin>
        </Span>
        
        <Span color="Comment" ruleSet="CommentMarkerSet" multiline="true">
            <Begin>/\*</Begin>
            <End>\*/</End>
        </Span>
        
        <!-- 字符串：包含普通字符串、逐字字符串、插值字符串、C# 11 原始字符串 -->
        <Span color="String">
            <Begin>"</Begin>
            <End>"</End>
            <RuleSet>
                <Span begin="\\" end="."/>
            </RuleSet>
        </Span>
        
        <Span color="Char">
            <Begin>'</Begin>
            <End>'</End>
            <RuleSet>
                <Span begin="\\" end="."/>
            </RuleSet>
        </Span>
        
        <Span color="String" multiline="true">
            <Begin>@"</Begin>
            <End>"</End>
            <RuleSet>
                <Span begin='""' end=""/>
            </RuleSet>
        </Span>
        
        <Span color="String" multiline="true">
            <Begin>"""</Begin>
            <End>"""</End>
        </Span>
        
        <Span color="String">
            <Begin>\$"</Begin>
            <End>"</End>
            <RuleSet>
                <Span begin="\\" end="."/>
                <Span begin="\{\{" end=""/>
                <Span begin="{" end="}" color="StringInterpolation" ruleSet=""/>
            </RuleSet>
        </Span>
        
        <Span color="String" multiline="true">
            <Begin>[$\$@|@\$]@"</Begin>
            <End>"</End>
            <RuleSet>
                <Span begin='""' end=""/>
                <Span begin="\{\{" end=""/>
                <Span begin="{" end="}" color="StringInterpolation" ruleSet=""/>
            </RuleSet>
        </Span>
        
        <!-- 避免 @变量 被识别为关键字 -->
        <Rule>@[\w\d_]+</Rule>
        
        <!-- ================= 关键字分类 ================= -->
        
        <Keywords color="ThisOrBaseReference">
            <Word>this</Word> <Word>base</Word>
        </Keywords>
        
        <Keywords color="TypeKeywords">
            <Word>as</Word> <Word>is</Word> <Word>new</Word>
            <Word>sizeof</Word> <Word>typeof</Word> <Word>stackalloc</Word>
        </Keywords>
        
        <Keywords color="TrueFalse">
            <Word>true</Word> <Word>false</Word>
        </Keywords>
        
        <Keywords color="Keywords">
            <Word>else</Word> <Word>if</Word> <Word>switch</Word> <Word>case</Word>
            <Word>default</Word> <Word>do</Word> <Word>for</Word> <Word>foreach</Word>
            <Word>in</Word> <Word>while</Word> <Word>lock</Word>
        </Keywords>
        
        <Keywords color="GotoKeywords">
            <Word>break</Word> <Word>continue</Word> <Word>goto</Word> <Word>return</Word>
        </Keywords>
        
        <!-- 上下文关键字（包含现代 C# 特性） -->
        <Keywords color="ContextKeywords">
            <Word>yield</Word> <Word>partial</Word> <Word>global</Word>
            <Word>where</Word> <Word>select</Word> <Word>group</Word>
            <Word>by</Word> <Word>into</Word> <Word>from</Word>
            <Word>ascending</Word> <Word>descending</Word> <Word>orderby</Word>
            <Word>let</Word> <Word>join</Word> <Word>on</Word> <Word>equals</Word>
            <Word>var</Word> <Word>dynamic</Word> <Word>await</Word>
            <Word>record</Word> <Word>init</Word> <Word>required</Word>
            <Word>with</Word> <Word>scoped</Word> <Word>file</Word>
        </Keywords>
        
        <Keywords color="ExceptionKeywords">
            <Word>try</Word> <Word>throw</Word> <Word>catch</Word> <Word>finally</Word>
        </Keywords>
        
        <Keywords color="CheckedKeyword">
            <Word>checked</Word> <Word>unchecked</Word>
        </Keywords>
        
        <Keywords color="UnsafeKeywords">
            <Word>fixed</Word> <Word>unsafe</Word>
        </Keywords>
        
        <Keywords color="ValueTypeKeywords">
            <Word>bool</Word> <Word>byte</Word> <Word>char</Word> <Word>decimal</Word>
            <Word>double</Word> <Word>enum</Word> <Word>float</Word> <Word>int</Word>
            <Word>long</Word> <Word>sbyte</Word> <Word>short</Word> <Word>struct</Word>
            <Word>uint</Word> <Word>ushort</Word> <Word>ulong</Word> <Word>nint</Word> <Word>nuint</Word>
        </Keywords>
        
        <Keywords color="ReferenceTypeKeywords">
            <Word>class</Word> <Word>interface</Word> <Word>delegate</Word>
            <Word>object</Word> <Word>string</Word> <Word>void</Word> <Word>record</Word>
        </Keywords>
        
        <Keywords color="OperatorKeywords">
            <Word>explicit</Word> <Word>implicit</Word> <Word>operator</Word>
        </Keywords>
        
        <Keywords color="ParameterModifiers">
            <Word>params</Word> <Word>ref</Word> <Word>out</Word> <Word>in</Word>
        </Keywords>
        
        <Keywords color="Modifiers">
            <Word>abstract</Word> <Word>const</Word> <Word>event</Word>
            <Word>extern</Word> <Word>override</Word> <Word>readonly</Word>
            <Word>sealed</Word> <Word>static</Word> <Word>virtual</Word>
            <Word>volatile</Word> <Word>async</Word>
        </Keywords>
        
        <Keywords color="Visibility">
            <Word>public</Word> <Word>protected</Word> <Word>private</Word> <Word>internal</Word>
        </Keywords>
        
        <Keywords color="NamespaceKeywords">
            <Word>namespace</Word> <Word>using</Word>
        </Keywords>
        
        <Keywords color="GetSetAddRemove">
            <Word>get</Word> <Word>set</Word> <Word>add</Word> <Word>remove</Word>
        </Keywords>
        
        <Keywords color="NullOrValueKeywords">
            <Word>null</Word> <Word>value</Word>
        </Keywords>
        <Keywords color="SemanticKeywords">
            <Word>nameof</Word>
        </Keywords>
        <!-- ================= 匹配规则 ================= -->
        
        <!-- 方法调用 -->
       <Rule color="MethodCall">
			\b[a-zA-Z_]\w*(?=\s*(?:&lt;(?:[^&lt;&gt;\r\n]|&lt;(?:[^&lt;&gt;\r\n]|&lt;(?:[^&lt;&gt;\r\n]|&lt;[^&lt;&gt;\r\n]*&gt;)*&gt;)*&gt;)*&gt;)?\s*\()
		</Rule>
        
        <!-- 数字（包含十六进制、二进制、浮点数） -->
        <Rule color="NumberLiteral">
            \b0[xX][0-9a-fA-F]+(_[0-9a-fA-F]+)* # hex
        |
            \b0[bB][01]+(_[01]+)* # binary
        |
            (   \b\d+(_\d+)*(\.[0-9]+)?  # number with optional floating point
            |   \.[0-9]+
            )
            ([eE][+-]?[0-9]+)? # optional exponent
        </Rule>
        
        <!-- 标点符号 -->
        <Rule color="Punctuation">
            [?,.;()\[\]{}+\-/%*&lt;&gt;^+~!|&amp;]+
        </Rule>
    </RuleSet>
</SyntaxDefinition>