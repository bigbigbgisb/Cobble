<UserControl x:Class="Cobble.Views.EasterEggPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ae="http://icsharpcode.net/sharpdevelop/avalonedit"
             xmlns:local="clr-namespace:Cobble.Views"
             mc:Ignorable="d" 
             xmlns:vm="clr-namespace:Cobble.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:EasterEggPageViewModel}"
             
             >
    <Grid x:Name="RootGrid">

        <Border CornerRadius="6" Margin="24" Padding="4">
            <Border.Background >
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Offset="0" Color="{Binding DataContext.ThemeViewModel.SurfaceColor,ElementName=RootGrid}"></GradientStop>
                    <GradientStop Offset="1" Color="{Binding DataContext.ThemeViewModel.BaseColor,ElementName=RootGrid}"></GradientStop>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                </Grid.RowDefinitions>
                <ScrollViewer Grid.RowSpan="3">
                    <Grid Margin="12">

                        <StackPanel >
                            <TextBlock VerticalAlignment="Top" HorizontalAlignment="Center" Text="看起来进入了菜单页，好吧，给你看点好东西↓太帅了，我的代码看得懂吗你哈哈哈哈" Foreground="{Binding ThemeViewModel.MainForeground}"></TextBlock>
                            <TextBlock VerticalAlignment="Top" HorizontalAlignment="Center"  Foreground="{Binding ThemeViewModel.MainForeground}">
                                <Run Text="本次读取的代码行数"></Run>
                                <Run Text="{Binding LinesOfCode}"></Run>
                                <Run Text="行"></Run>        
                            </TextBlock>
                            <TextBlock VerticalAlignment="Top" HorizontalAlignment="Center"  Foreground="{Binding ThemeViewModel.MainForeground}">
                                <Run Text="本次读取的代码字符数"></Run>
                                <Run Text="{Binding CharsOfCode}"></Run>
                                <Run Text="字符"></Run>
                            </TextBlock>
                            <TextBlock VerticalAlignment="Top" HorizontalAlignment="Center" Text="而且你肯定很烦开机自启动，这个是永久关闭的按钮噢" Foreground="{Binding ThemeViewModel.MainForeground}"></TextBlock>
                            <Button Margin="12" Background="{Binding ThemeViewModel.PopupBrush}" Command="{Binding DisableAutoStartCommand}" Foreground="{Binding ThemeViewModel.MainForeground}" Content="关闭" ></Button>
                            <TextBlock VerticalAlignment="Top" HorizontalAlignment="Center" Text="当然也不排除你就是喜欢" Foreground="{Binding ThemeViewModel.MainForeground}"></TextBlock>
                            <Button Margin="12" Background="{Binding ThemeViewModel.PopupBrush}" Command="{Binding EnableAutoStartCommand}" Foreground="{Binding ThemeViewModel.MainForeground}" Content="开启" ></Button>
                            <Border Margin="12" Background="{Binding ThemeViewModel.BaseBrush}">

                                <ae:TextEditor x:Name="CodeEditor"  IsHitTestVisible="False" Foreground="{Binding ThemeViewModel.MainForeground}" Background="{Binding ThemeViewModel.BaseBrush}"  SyntaxHighlighting="C#"  Margin="12" Document="{Binding Code}" IsReadOnly="True" FontFamily="Consolas"></ae:TextEditor>

                            </Border>
                            

                        </StackPanel>
                        <Border  Padding="32" CornerRadius="6" HorizontalAlignment="Right" VerticalAlignment="Top" Background="{Binding ThemeViewModel.PopupBrush}" >
                            <StackPanel Margin="12">
                                <TextBlock VerticalAlignment="Top" HorizontalAlignment="Center" Text="不要在意这里为什么有一个播放键" Foreground="{Binding ThemeViewModel.MainForeground}"></TextBlock>
                                <TextBlock VerticalAlignment="Top" HorizontalAlignment="Center" Text="你想点吗?" Foreground="{Binding ThemeViewModel.MainForeground}"></TextBlock>
                                <TextBlock VerticalAlignment="Top" HorizontalAlignment="Center" Text="这谁不想啊哈哈" Foreground="{Binding ThemeViewModel.MainForeground}"></TextBlock>
                                <Button Background="{Binding ThemeViewModel.PopupBrush}" Command="{Binding PlaySongCommand}" Margin="12" Content="▶ / ⏸" Foreground="{Binding ThemeViewModel.MainForeground}"></Button>
                                <TextBlock VerticalAlignment="Top" HorizontalAlignment="Center" Text="小镇姑娘 - 陶喆" Foreground="{Binding ThemeViewModel.MainForeground}"></TextBlock>
                            </StackPanel>

                        </Border>
                        

                    </Grid>
                </ScrollViewer>

                <Image Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Center" Source="pack://application:,,,/Cobble;component/Assets/CocaCola_can.png"></Image>
                <TextBlock Margin="12" Grid.Row="2" VerticalAlignment="Top" HorizontalAlignment="Right" Text="可以喝可乐噢" Foreground="{Binding ThemeViewModel.MainForeground}"></TextBlock>
            </Grid>

        </Border>
    </Grid>
</UserControl>
