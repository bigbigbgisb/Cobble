<UserControl x:Class="Cobble.Views.MemoPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Cobble.Views"
             mc:Ignorable="d" 
             xmlns:vm="clr-namespace:Cobble.ViewModels"
             xmlns:conv="clr-namespace:Cobble.Converters"
             d:DesignHeight="450" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance Type=vm:MemoPageViewModel}">
    <UserControl.Resources>
        <conv:TwoArgStringTupleConverter x:Key="TupleConverter"></conv:TwoArgStringTupleConverter>
    </UserControl.Resources>
    <Grid x:Name="RootGrid">

        <Border CornerRadius="6" Margin="24" Padding="4">
            <Border.Background >
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Offset="0" Color="{Binding DataContext.ThemeViewModel.SurfaceColor,ElementName=RootGrid}"></GradientStop>
                    <GradientStop Offset="1" Color="{Binding DataContext.ThemeViewModel.BaseColor,ElementName=RootGrid}"></GradientStop>
                </LinearGradientBrush>
            </Border.Background>
            <ScrollViewer Margin="0,16,0,0">

                <StackPanel>
                    <Grid>
                        <Border Margin="12,32,12,0" Padding="16,12,64,12" HorizontalAlignment="Stretch" Background="{Binding ThemeViewModel.PopupBrush}" CornerRadius="6">
                            <Border.Effect>
                                <DropShadowEffect Color="{Binding DataContext.ThemeViewModel.ShadowColor, ElementName=RootGrid}" BlurRadius="10" ShadowDepth="5" Direction="270" Opacity="0.4"></DropShadowEffect>
                            </Border.Effect>

                        </Border>
                        <Border Margin="12,32,12,0" Padding="16,12,64,12" HorizontalAlignment="Left" Background="{Binding ThemeViewModel.TransparentBrush}" CornerRadius="6">
                            <StackPanel Orientation="Horizontal">
                                <Border VerticalAlignment="Stretch" Width="8" Background="{Binding ThemeViewModel.ThemeBrush}" CornerRadius="4"></Border>
                                <StackPanel Margin="12,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock  Foreground="{Binding ThemeViewModel.MainForeground}" FontSize="24" Text="添加备忘录"></TextBlock>
                                    <TextBlock  Foreground="{Binding ThemeViewModel.MainForeground}" FontSize="18" Text="Add Memo"></TextBlock>
                                </StackPanel>
                            </StackPanel>
                            

                        </Border>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="12,24,0,0">
                        <TextBlock VerticalAlignment="Center" FontSize="16"  Foreground="{Binding ThemeViewModel.MainForeground}" Text="课程名"></TextBlock>
                        <TextBox Text="{Binding CurrentSubject,Mode=TwoWay}" Padding="12,8" VerticalAlignment="Center" FontSize="16"  Foreground="{Binding ThemeViewModel.MainForeground}" Margin="12,0,0,0" Width="192" Background="{Binding ThemeViewModel.PopupBrush}"></TextBox>
                        <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" FontSize="16"  Foreground="{Binding ThemeViewModel.MainForeground}" Text="备忘录信息"></TextBlock>
                        <TextBox Text="{Binding CurrentMemo,Mode=TwoWay}" Padding="12,8" VerticalAlignment="Center" FontSize="16"  Foreground="{Binding ThemeViewModel.MainForeground}" Margin="12,0,0,0" Width="192" Background="{Binding ThemeViewModel.PopupBrush}"></TextBox>
                        <Button Command="{Binding AddMemoCommand}" Foreground="{Binding ThemeViewModel.MainForeground}" Margin="24,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center" Background="{Binding ThemeViewModel.PopupBrush}" Content="添加备忘"></Button>
                    </StackPanel>


                    <Grid Margin="0,12,0,0">
                        <Border Margin="12,32,12,0" Padding="16,12,64,12" HorizontalAlignment="Stretch" Background="{Binding ThemeViewModel.PopupBrush}" CornerRadius="6">
                            <Border.Effect>
                                <DropShadowEffect Color="{Binding DataContext.ThemeViewModel.ShadowColor, ElementName=RootGrid}" BlurRadius="10" ShadowDepth="5" Direction="270" Opacity="0.4"></DropShadowEffect>
                            </Border.Effect>

                        </Border>
                        <Border  Margin="12,32,12,12" Padding="16,12,64,12" HorizontalAlignment="Stretch" Background="{Binding ThemeViewModel.TransparentBrush}" CornerRadius="6">
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <Border VerticalAlignment="Stretch" Width="8" Background="{Binding ThemeViewModel.ThemeBrush}" CornerRadius="4"></Border>
                                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Margin="12,0,0,0"  Foreground="{Binding ThemeViewModel.MainForeground}" FontSize="24" Text="今日已添加的备忘录"></TextBlock>
                                        <TextBlock Margin="12,0,0,0" Foreground="{Binding ThemeViewModel.MainForeground}" FontSize="18" Text="Current Memos"></TextBlock>
                                        <ItemsControl Margin="12,0,0,0" ItemsSource="{Binding Memos}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel>
                                                        <TextBlock TextWrapping="Wrap" Margin="0,12,0,0" Text="{Binding Key}" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Grid},Path=DataContext.ThemeViewModel.MainForeground}" FontSize="20"></TextBlock>
                                                        <ItemsControl ItemsSource="{Binding Value}">
      
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                                                                        <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" Text="{Binding Memo, StringFormat='    {0}'}"  Foreground="{Binding RelativeSource={RelativeSource AncestorType=Grid},Path=DataContext.ThemeViewModel.MainForeground}" FontSize="14">
                                                                        </TextBlock>
                                                                        <Button VerticalAlignment="Center" Command="{Binding RelativeSource={RelativeSource AncestorType=Grid},Path=DataContext.DeleteMemoCommand}" Background="{Binding RelativeSource={RelativeSource AncestorType=Grid},Path=DataContext.ThemeViewModel.TransparentBrush}" Margin="12,0,0,0" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Grid},Path=DataContext.ThemeViewModel.MainForeground}" FontSize="14" Content="删除">
                                                                            <Button.CommandParameter>
                                                                                <MultiBinding Converter="{StaticResource TupleConverter}">
                                                                                    <Binding Path="Memo"></Binding>
                                                                                    <Binding Path="Key"></Binding>
                                                                                </MultiBinding>
                                                                            </Button.CommandParameter>
                                                                        </Button>
                                                                    </StackPanel>

                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>

                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Stretch" Orientation="Horizontal">
                                    <StackPanel Margin="12" HorizontalAlignment="Right" VerticalAlignment="Stretch">
                                        <Button  BorderThickness="0" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{Binding ThemeViewModel.MainForeground}" Background="{Binding ThemeViewModel.PopupBrush}" Content="👁"  Command="{Binding TogglePopupWindowCommand}">

                                        </Button>
                                        <TextBlock Margin="0,6,0,0" Foreground="{Binding ThemeViewModel.MainForeground}" HorizontalAlignment="Center" VerticalAlignment="Center" Text="显示/隐藏主控台浮动"></TextBlock>
                                    </StackPanel>
                                    <StackPanel Margin="12" HorizontalAlignment="Right" VerticalAlignment="Stretch">
                                        <Button x:Name="ExportMemo" Click="ExportMemo_Click" BorderThickness="0" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{Binding ThemeViewModel.MainForeground}" Background="{Binding ThemeViewModel.PopupBrush}" Content="💾">

                                        </Button>
                                        <TextBlock Margin="0,6,0,0" Foreground="{Binding ThemeViewModel.MainForeground}" HorizontalAlignment="Center" VerticalAlignment="Center" Text="导出备忘录"></TextBlock>
                                    </StackPanel>
                                    <StackPanel Margin="12" HorizontalAlignment="Right" VerticalAlignment="Stretch">
                                        <Button x:Name="LoadMemo" Click="LoadMemo_Click" BorderThickness="0" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{Binding ThemeViewModel.MainForeground}" Background="{Binding ThemeViewModel.PopupBrush}" Content="📥">

                                        </Button>
                                        <TextBlock Margin="0,6,0,0" Foreground="{Binding ThemeViewModel.MainForeground}" HorizontalAlignment="Center" VerticalAlignment="Center" Text="导入备忘录"></TextBlock>
                                    </StackPanel>
                                    
                                </StackPanel>
                                
                            </Grid>
                            
                            
                        </Border>
                    </Grid>


                </StackPanel>
            </ScrollViewer>

        </Border>

    </Grid>
</UserControl>
