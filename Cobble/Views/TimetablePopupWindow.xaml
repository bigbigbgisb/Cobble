<Window x:Class="Cobble.Views.TimetablePopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Cobble.Views"
        mc:Ignorable="d"
        xmlns:vm ="clr-namespace:Cobble.ViewModels"
        xmlns:models="clr-namespace:Cobble.Models"
        Title="TimetablePopupWindow"     
        d:DataContext="{d:DesignInstance Type=vm:TimetablePopupWindowViewModel}"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{Binding ThemeViewModel.TransparentColor}"
        SizeToContent="Height"
        Width="192"
        ShowInTaskbar="False"
        Topmost="True"
        >
    
    <Grid Margin="12">
        <Border CornerRadius="6" BorderThickness="2" BorderBrush="{Binding ThemeViewModel.MainForeground}" Opacity="0.8" Background="{Binding ThemeViewModel.BaseColor}"></Border>
        <ItemsControl Padding="0,64,0,64"  ItemsSource="{Binding CurrentLessons.LessonInfos}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="models:LessonInfo">
                    <TextBlock   Margin="0,18,0,18" FontSize="24" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Grid},Path=DataContext.ThemeViewModel.MainForeground}" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding LessonName}"></TextBlock>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
