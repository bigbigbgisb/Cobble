<Window x:Class="Cobble.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Cobble"
        xmlns:vm="clr-namespace:Cobble.ViewModels"
        xmlns:views="clr-namespace:Cobble.Views"
        mc:Ignorable="d"
        Title="MainWindow"
        Height="600"
        Width="1200"
        d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel}"
        Background="Transparent"
        >
    
    <!--窗口自定义-->
    <WindowChrome.WindowChrome>
        <WindowChrome 
            ResizeBorderThickness="5" 
            CaptionHeight="0" 
            GlassFrameThickness="0" 
            CornerRadius="15" />
    </WindowChrome.WindowChrome>
    
    <!--资源字典联系ViewModel与View-->
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:TimetablePageViewModel}">
            <views:TimetablePage></views:TimetablePage>
        </DataTemplate>
    </Window.Resources>
    
    
    <Border HorizontalAlignment="Stretch" VerticalAlignment="Stretch"  Background="{Binding ThemeViewModel.BaseColor}">
        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"></RowDefinition>
                <RowDefinition Height="12*"></RowDefinition>
            </Grid.RowDefinitions>
            <ContentControl HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Grid.Row="1" Content="{Binding NavigationService.CurrentPage}"></ContentControl>
            <Border Grid.Row="0">
                <Grid MouseDown="TitleBar_MouseDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"></ColumnDefinition>
                        <ColumnDefinition Width="Auto"></ColumnDefinition>
                        <ColumnDefinition Width="Auto"></ColumnDefinition>
                        <ColumnDefinition Width="Auto"></ColumnDefinition>
                        <ColumnDefinition Width="Auto"></ColumnDefinition>
                        <ColumnDefinition Width="10*"></ColumnDefinition>
                        <ColumnDefinition Width="Auto"></ColumnDefinition>
                        <ColumnDefinition Width="Auto"></ColumnDefinition>
                        <ColumnDefinition Width="Auto"></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <Image VerticalAlignment="Top" Source="/Assets/CobbleIcon.png"></Image>
                    <Button HorizontalContentAlignment="Left"   Padding="12,8,28,8"  Margin="8,8,4,4" Foreground="{Binding ThemeViewModel.MainForeground}" Grid.Column="1" Background="{Binding ThemeViewModel.TransparentColor}" Content="课表"></Button>
                    <Button HorizontalContentAlignment="Left"  Padding="12,8,28,8" Margin="4,8,4,4" Foreground="{Binding ThemeViewModel.MainForeground}" Grid.Column="2" Background="{Binding ThemeViewModel.TransparentColor}" Content="抽奖"></Button>
                    <Button HorizontalContentAlignment="Left"  Padding="12,8,28,8" Margin="4,8,4,4" Foreground="{Binding ThemeViewModel.MainForeground}" Grid.Column="3" Background="{Binding ThemeViewModel.TransparentColor}" Content="备忘"></Button>
                    <Button HorizontalContentAlignment="Left"  Padding="12,8,28,8" Margin="4,8,4,4" Foreground="{Binding ThemeViewModel.MainForeground}" Grid.Column="4" Background="{Binding ThemeViewModel.TransparentColor}" Content="白板"></Button>
                    <Border HorizontalAlignment="Stretch" x:Name="DragBar" Grid.Column="5" ></Border>

                    <Button Click="Minimize_Click" x:Name="Minimize" HorizontalContentAlignment="Left"  Padding="28,8" Foreground="{Binding ThemeViewModel.MainForeground}" Grid.Column="6" Background="{Binding ThemeViewModel.TransparentColor}" Content="–"></Button>
                    <Button Click="Maximize_Click" x:Name="Maximize" HorizontalContentAlignment="Left"  Padding="28,8" Foreground="{Binding ThemeViewModel.MainForeground}" Grid.Column="7" Background="{Binding ThemeViewModel.TransparentColor}" Content="□"></Button>
                    <Button Click="Close_Click" x:Name="Close" HorizontalContentAlignment="Left" Margin="0,0,8,0"  Padding="28,8" Foreground="{Binding ThemeViewModel.MainForeground}" Grid.Column="8" Background="{Binding ThemeViewModel.TransparentColor}" Content="×"></Button>
                </Grid>
            </Border>



        </Grid>
    </Border>

</Window>
