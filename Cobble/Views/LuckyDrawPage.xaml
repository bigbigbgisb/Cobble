<UserControl x:Class="Cobble.Views.LuckyDrawPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Cobble.Views"
             xmlns:vm="clr-namespace:Cobble.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:LuckyDrawPageViewModel}">
    <Grid x:Name="RootGrid">

        <Border CornerRadius="6" Margin="24" Padding="4">
            <Border.Background >
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Offset="0" Color="{Binding DataContext.ThemeViewModel.SurfaceColor,ElementName=RootGrid}"></GradientStop>
                    <GradientStop Offset="1" Color="{Binding DataContext.ThemeViewModel.BaseColor,ElementName=RootGrid}"></GradientStop>
                </LinearGradientBrush>
            </Border.Background>
            <ScrollViewer>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="*"></RowDefinition>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"></ColumnDefinition>
                        <ColumnDefinition Width="*"></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.ColumnSpan="2">
                        <StackPanel Orientation="Horizontal">
                            <Border VerticalAlignment="Stretch" Width="2" Background="{Binding ThemeViewModel.ThemeBrush}" Margin="12"></Border>
                            <TextBlock Margin="12" Foreground="{Binding ThemeViewModel.MainForeground}">
                            <Run FontSize="36" Text="抽奖"></Run>
                            <LineBreak></LineBreak>
                            <Run FontSize="20" Text="Lucky Draw"></Run>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                    <Border Padding="64" Grid.Row="1" CornerRadius="12" Margin="16" Background="{Binding ThemeViewModel.PopupBrush}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <Grid>
                            <Border CornerRadius="12" Padding="32" Background="{Binding ThemeViewModel.ThemeBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock FontSize="32" FontWeight="Bold" Foreground="{Binding ThemeViewModel.MainForeground}" Text="{Binding CurrentItem}"></TextBlock>
                            </Border>
                        </Grid>
                    </Border>
                    
                    <Border Padding="64" Grid.Row="1" Grid.Column="1" CornerRadius="12" Margin="32,16,32,16" Background="{Binding ThemeViewModel.PopupBrush}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <Grid>
                            <Border x:Name="Groove" VerticalAlignment="Stretch" HorizontalAlignment="Center" Width="4" Background="{Binding ThemeViewModel.BaseBrush}"></Border>
                            <Button Command="{Binding DrawCommand}" BorderThickness="0" x:Name="Rod" Click="Rod_Click"   Background="{Binding ThemeViewModel.ThemeBrush}" HorizontalAlignment="Stretch" VerticalAlignment="Top" Height="32">
                                <Button.Effect>
                                    <DropShadowEffect Color="{Binding DataContext.ThemeViewModel.ShadowColor, ElementName=RootGrid}" BlurRadius="10" ShadowDepth="5" Direction="270" Opacity="0.4"></DropShadowEffect>
                                </Button.Effect>
                                <Button.RenderTransform>
                                    <TranslateTransform x:Name="RodTranslateTransform"></TranslateTransform>
                                </Button.RenderTransform>
                            </Button>
                            
                        </Grid>
                    </Border>
                    <TextBlock Grid.Row="1" Grid.Column="1" Margin="32" FontSize="16" Foreground="{Binding ThemeViewModel.MainForeground}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Text="拉下拉杆抽奖!"></TextBlock>
                    
                </Grid>

            </ScrollViewer>

        </Border>
    </Grid>
</UserControl>
