<UserControl x:Class="Cobble.Views.TimetablePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Cobble.Views"
             xmlns:vm="clr-namespace:Cobble.ViewModels"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:behaviors="clr-namespace:Cobble.Behaviors"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance Type=vm:TimetablePageViewModel}"
             
             >

    <Grid>
        <Border CornerRadius="6" Margin="12" Background="{Binding ThemeViewModel.SurfaceColor}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                </Grid.RowDefinitions>
                <Border Margin="0,32,0,0" Padding="16,12,64,12" HorizontalAlignment="Left" Background="{Binding ThemeViewModel.PopupColor}" CornerRadius="0,20,20,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                        </Grid.RowDefinitions>
                        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock  Foreground="{Binding ThemeViewModel.MainForeground}" FontSize="24" Text="映射表"></TextBlock>
                            <TextBlock  Foreground="{Binding ThemeViewModel.MainForeground}" FontSize="18" Text="Mapping table"></TextBlock>
                            <TextBlock Margin="0,12,0,0"  Foreground="{Binding ThemeViewModel.MainForeground}" FontSize="14" Text="可选快捷输入 (在输入栏填入数字,紧接着按下分号,自动映射为课程名)"></TextBlock>

                        </StackPanel>
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding SubjectHints}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Foreground="{Binding DataContext.ThemeViewModel.MainForeground, RelativeSource={RelativeSource AncestorType=ItemsControl}}" FontSize="14" Margin="0,12,12,0" Text="{Binding}"></TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </Grid>


                </Border>
                <ScrollViewer Grid.Row="1" Margin="0,16,0,0">
                    <StackPanel>
                        
                        <Border Margin="0,32,0,0" Padding="16,12,64,12" HorizontalAlignment="Left" Background="{Binding ThemeViewModel.PopupColor}" CornerRadius="0,20,20,0">

                        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock  Foreground="{Binding ThemeViewModel.MainForeground}" FontSize="24" Text="课表设置"></TextBlock>
                            <TextBlock  Foreground="{Binding ThemeViewModel.MainForeground}" FontSize="18" Text="Timetable Settings"></TextBlock>
                        </StackPanel>

                    </Border>



                    <StackPanel Orientation="Horizontal" Margin="12,24,0,0">
                        <TextBlock VerticalAlignment="Center" FontSize="16"  Foreground="{Binding ThemeViewModel.MainForeground}" Text="课程表行数"></TextBlock>
                        <TextBox Text="{Binding RowCountInput,Mode=TwoWay}" Padding="12,8" VerticalAlignment="Center" FontSize="16"  Foreground="{Binding ThemeViewModel.MainForeground}" Margin="12,0,0,0" Width="192" Background="{Binding ThemeViewModel.PopupColor}"></TextBox>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="12,24,0,0">
                        <TextBlock VerticalAlignment="Center" FontSize="16"  Foreground="{Binding ThemeViewModel.MainForeground}" Text="课程表列数"></TextBlock>
                        <TextBox Text="{Binding ColumnCountInput,Mode=TwoWay}" Padding="12,8" VerticalAlignment="Center" FontSize="16"  Foreground="{Binding ThemeViewModel.MainForeground}" Margin="12,0,0,0" Width="192" Background="{Binding ThemeViewModel.PopupColor}"></TextBox>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding TipText}" >
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Margin="12,12,0,0" Text="{Binding}" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Grid},Path=DataContext.ThemeViewModel.WarningForeground}"></TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>

                    </ItemsControl>
                    <Border Padding="16,12,64,12" Margin="0,32,0,0" HorizontalAlignment="Left" Background="{Binding ThemeViewModel.PopupColor}" CornerRadius="0,20,20,0">
                        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock  Foreground="{Binding ThemeViewModel.MainForeground}" FontSize="24" Text="课表预览与修改"></TextBlock>
                            <TextBlock Foreground="{Binding ThemeViewModel.MainForeground}" FontSize="18" Text="Timetable Preview &amp; Modify"></TextBlock>
                        </StackPanel>

                    </Border>

                    <ItemsControl ItemsSource="{Binding WeeklyLessonInfos}" Margin="12,12,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ItemsControl ItemsSource="{Binding LessonInfos}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1"></UniformGrid>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>

                                        <DataTemplate>
                                            <Border Opacity="0" BorderThickness="1" BorderBrush="{Binding RelativeSource={RelativeSource AncestorType=Grid},Path=DataContext.ThemeViewModel.MainForeground}" Height="64" >
                                                <Border.Triggers>
                                                    <EventTrigger RoutedEvent="Loaded">
                                                        <BeginStoryboard>
                                                            <Storyboard  >
                                                                <DoubleAnimation Duration="0:0:1" From="0" To="1" Storyboard.TargetProperty="Opacity">

                                                                    <DoubleAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseIn"></CubicEase>
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>

                                                    </EventTrigger>
                                                </Border.Triggers>
                                                <TextBox HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontSize="18" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Grid},Path=DataContext.ThemeViewModel.MainForeground}" Background="{Binding RelativeSource={RelativeSource AncestorType=Grid},Path=DataContext.ThemeViewModel.PopupColor}"  Margin="12" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Text="{Binding LessonName,Mode=TwoWay}">
                                                    <i:Interaction.Behaviors>
                                                        <behaviors:SubjectMappingBehavior></behaviors:SubjectMappingBehavior>
                                                    </i:Interaction.Behaviors>
                                                </TextBox>

                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                        <Button HorizontalAlignment="Left" Margin="12" Background="{Binding ThemeViewModel.PopupColor}" Content="显示/隐藏浮动课表" Command="{Binding TogglePopupWindowCommand}"></Button>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

        </Border>
    </Grid>
</UserControl>
