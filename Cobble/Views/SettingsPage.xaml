<UserControl x:Class="Cobble.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Cobble.Views"
             xmlns:vm="clr-namespace:Cobble.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:SettingsPageViewModel}">
    <Grid x:Name="RootGrid">
        <Border  CornerRadius="6" Margin="24" Padding="4">
            <Border.Background >
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Offset="0" Color="{Binding DataContext.ThemeViewModel.SurfaceColor,ElementName=RootGrid}"></GradientStop>
                    <GradientStop Offset="1" Color="{Binding DataContext.ThemeViewModel.BaseColor,ElementName=RootGrid}"></GradientStop>
                </LinearGradientBrush>
            </Border.Background>
            <ScrollViewer Margin="12,16,12,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border VerticalAlignment="Stretch" Width="2" Background="{Binding ThemeViewModel.ThemeBrush}"></Border>
                        <TextBlock Margin="12" Foreground="{Binding ThemeViewModel.MainForeground}">
                            <Run FontSize="36" Text="设置"></Run>
                            <LineBreak></LineBreak>
                            <Run FontSize="20" Text="Settings"></Run>
                        </TextBlock>
                        
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="切换主题" Foreground="{Binding ThemeViewModel.MainForeground}" Margin="0,12" FontSize="18"></TextBlock>
                        <Button Command="{Binding ChangeThemeCommand}"  Margin="12,12" Background="{Binding ThemeViewModel.PopupBrush}" BorderThickness="0" >
                            <TextBlock Foreground="{Binding ThemeViewModel.MainForeground}" Text="=/=" Padding="0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16">
                            </TextBlock>
                        </Button>
                    </StackPanel>
                    
                </StackPanel>
            </ScrollViewer>
        </Border>
        <TextBlock FontSize="8" Margin="12" HorizontalAlignment="Right" VerticalAlignment="Bottom" Foreground="{Binding ThemeViewModel.MainForeground}" Opacity="0.4" Text="bigbigbgisb"></TextBlock>
    </Grid>
</UserControl>
