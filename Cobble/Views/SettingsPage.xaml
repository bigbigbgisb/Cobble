<UserControl x:Class="Cobble.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Cobble.ViewModels"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:SettingsPageViewModel}">
    <Grid x:Name="RootGrid">
        <Border  CornerRadius="6" Margin="24" Padding="4">
            <Border.Background >
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Offset="0" Color="{Binding DataContext.ThemeViewModel.SurfaceColor,ElementName=RootGrid}"></GradientStop>
                    <GradientStop Offset="1" Color="{Binding DataContext.ThemeViewModel.BaseColor,ElementName=RootGrid}"></GradientStop>
                </LinearGradientBrush>
            </Border.Background>
            <ScrollViewer Margin="12,24,12,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border VerticalAlignment="Stretch" Width="2" Background="{Binding ThemeViewModel.ThemeBrush}"></Border>
                        <TextBlock Margin="12" Foreground="{Binding ThemeViewModel.MainForeground}">
                            <Run FontSize="36" Text="设置"></Run>
                            <LineBreak></LineBreak>
                            <Run FontSize="20" Text="Settings"></Run>
                        </TextBlock>
                        
                    </StackPanel>
                    <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                        <TextBlock Text="切换主题" Foreground="{Binding ThemeViewModel.MainForeground}" Margin="0,12" FontSize="16"></TextBlock>
                        <Border HorizontalAlignment="Center" VerticalAlignment="Center" Height="24" Width="24" Margin="12,0" CornerRadius="6" Background="{Binding ThemeViewModel.ThemeBrush}"></Border>
                        <hc:ComboBox  Foreground="{Binding ThemeViewModel.ThemeBrush}" MinWidth="96" Background="{Binding ThemeViewModel.PopupBrush}" Margin="12,0" VerticalAlignment="Center" ItemsSource="{Binding ThemeViewModel.ThemeInfos}" SelectedValue="{Binding ThemeViewModel.CurrentTheme, Mode=TwoWay}" SelectedValuePath="Key" DisplayMemberPath="Value.ThemeName">
                        </hc:ComboBox>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="开启自动显示中控" Foreground="{Binding ThemeViewModel.MainForeground}" Margin="0,12" FontSize="16"></TextBlock>
                        <Button Command="{Binding StartAutoShowTimerCommand}"  Margin="12,0" Background="{Binding ThemeViewModel.PopupBrush}" BorderThickness="0" >
                            <TextBlock Foreground="{Binding ThemeViewModel.MainForeground}" Text="📕" Padding="0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16">
                            </TextBlock>
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="关闭自动显示中控" Foreground="{Binding ThemeViewModel.MainForeground}" Margin="0,12" FontSize="16"></TextBlock>
                        <Button Command="{Binding StopAutoShowTimerCommand}"  Margin="12,0" Background="{Binding ThemeViewModel.PopupBrush}" BorderThickness="0" >
                            <TextBlock Foreground="{Binding ThemeViewModel.MainForeground}" Text="📕" Padding="0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16">
                            </TextBlock>
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="临时关闭中控时间(分)" Foreground="{Binding ThemeViewModel.MainForeground}" Margin="0,12" FontSize="16"></TextBlock>
                        <TextBox MinWidth="96" Text="{Binding DurationInput,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="12" Background="{Binding ThemeViewModel.PopupBrush}" Foreground="{Binding ThemeViewModel.MainForeground}" BorderThickness="0"></TextBox>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding TipText}" >
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock  Margin="12,0" Text="{Binding}" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Grid},Path=DataContext.ThemeViewModel.WarningForeground}"></TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>
        <TextBlock FontSize="8" Margin="12" HorizontalAlignment="Right" VerticalAlignment="Bottom" Foreground="{Binding ThemeViewModel.MainForeground}" Opacity="0.4" Text="bigbigbgisb"></TextBlock>
    </Grid>
</UserControl>
