		<PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.161" />
	</ItemGroup>

	<ItemGroup>
		<Resource Include="Assets\CobbleIcon.png" />
	</ItemGroup>



</Project>
